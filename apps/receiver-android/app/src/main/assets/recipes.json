          "current": "Episodio (\\S+)",
          "currentNode": "episode-comment",
          "list": "animeId",
          "ranges": "^(\\d+) - (?:.* - )?(\\d+)$",
          "prev": "Precedente$",
          "next": "Successivo$"
        }
      ]
    },
    "start": {
      "urlBarViewIds": [
        ":id/url_bar"
      ],
      "sites": [
        {
          "site": "animeworld",
          "url": "^(https?://)?(www\\.)?animeworld\\.[a-z]+/play/",
          "control": {
            "viewIds": [
              "player-cover"
            ],
            "climb": 2
          },
          "notStarted": {
            "viewIds": [
              "player-cover"
            ]
          },
          "started": {
            "viewIds": [
              "player-iframe"
            ]
          },
          "play": {
            "labels": [
              "play"
            ],
            "within": "player-iframe"
          },
          "waitMs": 5000,
          "pollMs": 300
        }
      ]
    },
    "press": [
      "tap",
      "click"
    ]
  },
